---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContentListItem from '../components/ContentListItem.astro';
import ArticleToc from '../components/ArticleToc.astro';
import ShareButton from '../components/ShareButton.astro';
import bismillah from '../assets/bismillah.svg';
import authorPhoto from '../assets/me.webp';
import {
  DEFAULT_AUTHOR,
  getAllContent,
  getCategories,
  getRelated,
  getSectionMembership,
  getSiteSettings,
  type ContentItem,
} from '../lib/sanity';
import { renderMarkdown } from '../lib/markdown';
import { ogImagePath } from '../lib/og';
import { CONTENT_LABELS } from '../lib/content-types';

interface Props {
  item: ContentItem;
}

const { item } = Astro.props;

const [catalog, settings, categories, sectionMembership] = await Promise.all([
  getAllContent(),
  getSiteSettings(),
  getCategories(),
  getSectionMembership(),
]);
const related = getRelated(item, catalog, sectionMembership, 3);

const isQuestion = item.type === 'question';
const isReadable = item.type !== 'pdf';
const { html, toc } = isReadable
  ? renderMarkdown(item.content || '')
  : { html: '', toc: [] };
const hasToc = toc.length > 0;

const dateLabel = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(item.date + 'T00:00:00'));

const category = isQuestion ? 'questions' : item.category!.slug;
const ogImage = new URL(ogImagePath(category, item.slug), Astro.site).href;
---

<BaseLayout
  title={`${item.title} | Thaqib ibn Fazle`}
  description={item.summary}
  ogType={isReadable ? 'article' : 'website'}
  publishedTime={item.date}
  ogImage={ogImage}
  ogImageWidth={1200}
  ogImageHeight={630}
>
  <div class:list={{ 'question-detail': isQuestion }}>
  <a class="back-link" href={isQuestion ? "/questions" : "/"}>
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5"></path>
      <path d="m12 19-7-7 7-7"></path>
    </svg>
    {isQuestion ? 'Back to questions' : 'Back to home'}
  </a>

  <div class:list={['article-shell', { 'article-shell--with-toc': hasToc, 'article-shell--question': isQuestion }]}>
    {hasToc && <ArticleToc items={toc} />}

    <main>
      <article>
        <p class="article-category">
          {CONTENT_LABELS[item.type]}{item.category && ` · ${item.category.title}`}
        </p>
        <h1 class="article-title">{item.title}</h1>

        <div class="article-meta">
          <span class="article-meta__author">
            <img
              class="article-meta__avatar"
              src={authorPhoto.src}
              alt=""
              width="32"
              height="32"
              loading="eager"
              decoding="async"
            />
            {DEFAULT_AUTHOR}
          </span>
          <div class="article-meta__rest">
            <span class="article-meta__item">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                <path d="M16 2v4M8 2v4M3 10h18"></path>
              </svg>
              <time datetime={item.date}>{dateLabel}</time>
            </span>
            {
              item.readTime && (
                <span class="article-meta__item">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M12 6v6l4 2"></path>
                  </svg>
                  {item.readTime} min
                </span>
              )
            }
            {
              item.pageCount && (
                <span class="article-meta__item">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <path d="M14 2v6h6"></path>
                  </svg>
                  {item.pageCount} pages
                </span>
              )
            }
            {isReadable && <ShareButton title={item.title} text={item.summary} />}
          </div>
        </div>

        {isQuestion && item.question && (
          <section class="qa-question" aria-labelledby="qa-question-heading">
            <h2 class="qa-section-label" id="qa-question-heading">The Question</h2>
            {item.question.split(/\n\s*\n/).filter((paragraph) => paragraph.trim()).map((paragraph) => (
              <p class="qa-question__text" dir="auto">{paragraph}</p>
            ))}
          </section>
        )}

        {
          !isQuestion && item.imageUrl && (
            <img
              class="article-thumbnail"
              src={item.imageUrl}
              alt=""
              width="960"
              height="540"
              loading="eager"
              decoding="async"
            />
          )
        }

        {
          isReadable ? (
            <>
              {isQuestion && <h2 class="qa-section-label qa-answer-label" id="qa-answer-heading">The Answer</h2>}
              <img
                class="article-bismillah"
                src={bismillah.src}
                alt="Bismillah"
                width="320"
                height="80"
              />
              <section class="markdown-body" aria-label={isQuestion ? "Answer" : "Article content"} set:html={html} />
            </>
          ) : (
            <div class="pdf-page">
              <p class="pdf-page__summary">{item.summary}</p>
              {
                item.fileUrl && (
                  <a
                    class="pdf-page__download"
                    href={item.fileUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Download PDF
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                )
              }
            </div>
          )
        }
      </article>

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <div class="section-label">
              <h2 class="section-label__title" id="related-heading">Related Content</h2>
            </div>
            <ul class="content-list">
              {related.map((relatedItem) => (
                <li>
                  <ContentListItem item={relatedItem} />
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>
  </div>
  </div>

  <SiteFooter settings={settings} categories={categories} />
</BaseLayout>
